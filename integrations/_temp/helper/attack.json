        "img": "modules/dsa5-armory/icons/rangeweapon/Elfenbogen.webp",
        "system": {
          "templates:": ["equipment", "description"],
          "crit": 1,
          "botch": 20,
          "region": "Elfen",
          "damage": {
            "value": "1W6+5"
          },
          "reloadTime": {
            "value": "1",
            "progress": 0
